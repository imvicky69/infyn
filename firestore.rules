rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Movies catalog and protected download links
    match /movies/{movieId} {
      // Disallow all direct client reads and writes.
      // All download requests must be verified through the secure Node.js API (/api/movies/download)
      // using the Firebase Admin SDK, ensuring Google Drive links cannot be scraped from the browser.
      allow read, write: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
