{
  "name": "infyn",
  "version": "1.0.0",
  "description": "Fast, 100% free, client-side in-browser PDF and image processing utilities.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./pdf": {
      "types": "./dist/pdf/index.d.ts",
      "import": "./dist/pdf/index.mjs",
      "require": "./dist/pdf/index.cjs"
    },
    "./image": {
      "types": "./dist/image/index.d.ts",
      "import": "./dist/image/index.mjs",
      "require": "./dist/image/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "infyn",
    "pdf",
    "pdf-merger",
    "pdf-splitter",
    "pdf-protector",
    "pdf-unlocker",
    "image-compressor",
    "heic-to-jpg",
    "exif-remover",
    "client-side",
    "browser",
    "wasm"
  ],
  "author": "Infyn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imvicky69/infyn.git"
  },
  "bugs": {
    "url": "https://github.com/imvicky69/infyn/issues"
  },
  "homepage": "https://infyn.software",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:lib": "tsup",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@gsap/react": "^2.1.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@imgly/background-removal": "^1.7.0",
    "@types/jszip": "^3.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cryptpdf": "^0.1.1",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "heic2any": "^0.0.4",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "libheif-js": "^1.19.8",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "onnxruntime-web": "^1.21.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5"
  }
}
